{
  "name": "upfanyi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:frontend": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "verify:rust": "pnpm rust:format:check && pnpm rust:check && pnpm rust:test",
    "verify": "pnpm verify:frontend && pnpm verify:rust",
    "spec:check": "openspec validate --all --strict && openspec validate --archived --strict",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build -- --locked",
    "rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
