<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upfanyi.controller.HistoryController"
      spacing="8"
      styleClass="side-panel-content">

    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <!-- 工具栏 -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="%history.search" HBox.hgrow="ALWAYS"/>
        <Button fx:id="searchButton" text="搜索" onAction="#handleSearch"/>
        <Button fx:id="clearAllButton" text="%history.clear" onAction="#handleClearAll" styleClass="danger-button"/>
    </HBox>

    <!-- 历史记录表格 -->
    <TableView fx:id="historyTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="sourceColumn" text="%label.source_text" prefWidth="100"/>
            <TableColumn fx:id="resultColumn" text="%label.result" prefWidth="100"/>
            <TableColumn fx:id="apiColumn" text="%label.api" prefWidth="60"/>
            <TableColumn fx:id="timeColumn" text="时间" prefWidth="70"/>
        </columns>
        <placeholder>
            <Label text="%history.empty"/>
        </placeholder>
    </TableView>

    <!-- 详情区域 -->
    <TitledPane text="详情" expanded="false">
        <VBox spacing="6">
            <padding>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </padding>

            <VBox spacing="4">
                <Label text="%label.source_text" styleClass="detail-label"/>
                <TextArea fx:id="sourceTextArea" wrapText="true" editable="false" prefRowCount="3"/>
            </VBox>

            <VBox spacing="4">
                <Label text="%label.result" styleClass="detail-label"/>
                <TextArea fx:id="resultTextArea" wrapText="true" editable="false" prefRowCount="3"/>
            </VBox>

            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button fx:id="copyButton" text="%button.copy" onAction="#handleCopy"/>
                <Button fx:id="deleteButton" text="%history.delete" onAction="#handleDelete" styleClass="danger-button"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
