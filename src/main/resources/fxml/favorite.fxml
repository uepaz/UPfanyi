<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upfanyi.controller.FavoriteController"
      spacing="8"
      styleClass="side-panel-content">

    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <!-- 工具栏 -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="%favorite.search" HBox.hgrow="ALWAYS"/>
        <Button fx:id="searchButton" text="搜索" onAction="#handleSearch"/>
        <Button fx:id="exportButton" text="%favorite.export" onAction="#handleExport"/>
    </HBox>

    <!-- 收藏表格 -->
    <TableView fx:id="favoriteTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="wordColumn" text="单词/句子" prefWidth="120"/>
            <TableColumn fx:id="translationColumn" text="%label.result" prefWidth="120"/>
            <TableColumn fx:id="timeColumn" text="时间" prefWidth="80"/>
        </columns>
        <placeholder>
            <Label text="%favorite.empty"/>
        </placeholder>
    </TableView>

    <!-- 详情区域 -->
    <TitledPane text="详情" expanded="false">
        <VBox spacing="6">
            <padding>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </padding>

            <VBox spacing="4">
                <Label text="单词/句子" styleClass="detail-label"/>
                <TextArea fx:id="wordTextArea" wrapText="true" editable="false" prefRowCount="3"/>
            </VBox>

            <VBox spacing="4">
                <Label text="%label.result" styleClass="detail-label"/>
                <TextArea fx:id="translationTextArea" wrapText="true" editable="false" prefRowCount="3"/>
            </VBox>

            <VBox spacing="4">
                <Label text="备注" styleClass="detail-label"/>
                <TextArea fx:id="noteTextArea" wrapText="true" prefRowCount="2" promptText="添加备注..."/>
            </VBox>

            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button fx:id="copyButton" text="%button.copy" onAction="#handleCopy"/>
                <Button fx:id="saveNoteButton" text="保存备注" onAction="#handleSaveNote"/>
                <Button fx:id="deleteButton" text="%history.delete" onAction="#handleDelete" styleClass="danger-button"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
