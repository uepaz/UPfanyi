<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.upfanyi.controller.MainController"
      fx:id="rootPane"
      styleClass="main-root">

    <!-- 左侧主界面 -->
    <VBox fx:id="mainContent" styleClass="main-content" spacing="8" prefWidth="420" minWidth="420">
        <padding>
            <Insets top="12" right="12" bottom="12" left="12"/>
        </padding>

        <!-- 源文本区域 -->
        <VBox spacing="4">
            <Label text="%label.source_text" styleClass="section-label"/>
            <TextArea fx:id="sourceTextArea"
                      promptText="%prompt.enter_text"
                      wrapText="true"
                      prefRowCount="4"
                      styleClass="source-text-area"/>
        </VBox>

        <!-- 控制栏 - 第一行：翻译引擎和翻译按钮 -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="%label.api" styleClass="control-label"/>
            <ComboBox fx:id="apiComboBox" prefWidth="120" minWidth="100"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="translateButton" text="%button.translate" onAction="#handleTranslate" styleClass="primary-button"/>
            <Button fx:id="favoriteButton" text="%button.favorite" onAction="#handleFavorite"/>
        </HBox>

        <!-- 控制栏 - 第二行：语言选择 -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="sourceLangComboBox" prefWidth="100" minWidth="80"/>
            <Button fx:id="swapButton" text="⇄" onAction="#handleSwapLanguage" styleClass="swap-button"/>
            <ComboBox fx:id="targetLangComboBox" prefWidth="100" minWidth="80"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- 结果区域 -->
        <VBox spacing="4" VBox.vgrow="ALWAYS">
            <Label text="%label.result" styleClass="section-label"/>
            <TextArea fx:id="resultTextArea"
                      wrapText="true"
                      editable="false"
                      VBox.vgrow="ALWAYS"
                      styleClass="result-text-area"/>
        </VBox>

        <!-- 底部工具栏 -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="copyButton" text="%button.copy" onAction="#handleCopy"/>
            <Button fx:id="historyButton" text="%button.history" onAction="#handleHistory"/>
            <Button text="%favorite.title" onAction="#handleFavoriteList"/>
            <Button fx:id="settingsButton" text="%button.settings" onAction="#handleSettings"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>
    </VBox>

    <!-- 右侧侧边面板容器 -->
    <StackPane fx:id="sidePanelContainer" styleClass="side-panel-container" visible="false" managed="false" minWidth="420" prefWidth="420"/>
</HBox>
